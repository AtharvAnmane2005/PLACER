%% ===========================================================================
%% PLACER — AI-Powered Campus Recruitment & Placement Assistance System
%% System architecture, entity-relationship model, database schema,
%% complete data-flow diagram (15 workflows), role workflows and AI model
%% architecture.
%%
%% Source of truth: the implementation under PLACER/backend and PLACER/frontend.
%% Every node, table, field, endpoint and collection name below exists in the
%% codebase. Planned or unimplemented elements are marked "PLANNED" or
%% "NOT IMPLEMENTED" and never drawn as if they existed.
%%
%% This file holds eight independent diagram groups (A, B, C, D, E1, E2, E3,
%% F). Each group is a complete, standalone Mermaid definition: render a
%% single group by copying its block into any Mermaid renderer (mermaid.live,
%% VS Code Mermaid extension, mermaid-cli). A .mmd file itself is not
%% auto-rendered by GitHub, and the groups are NOT meant to be rendered as one
%% combined document (they use different diagram types). The Markdown
%% companions cross-reference the groups but do not duplicate the definitions.
%%
%% Companion documents:
%%   docs/PLACER_MATHEMATICAL_FORMULAS_AND_ALGORITHMS.md
%%   docs/PLACER_SYSTEM_DESIGN_AND_DATA_FLOW.md
%% ===========================================================================


%% ===========================================================================
%% GROUP A — FULL SYSTEM ARCHITECTURE
%% Layers: client -> edge -> API -> domain services -> data / ML / external.
%% ===========================================================================

flowchart TB
  subgraph CLIENT["Client tier — Next.js 15.5.18 App Router, React 19, port 3000"]
    direction TB
    LANDING["Public landing<br/>app/page.tsx"]
    AUTHUI["Auth UI<br/>app/(auth)/login · /register"]

    subgraph STU["Student interface — app/(student)"]
      direction TB
      S_DASH["/dashboard<br/>KPIs · status donut · radar"]
      S_DRIVES["/dashboard/drives<br/>/dashboard/drives/[id]"]
      S_APPS["/dashboard/applications"]
      S_RESUME["/dashboard/resume"]
      S_EXAM["/dashboard/assessments<br/>/take/[attemptId] · /results/[attemptId]"]
      S_INSIGHTS["/dashboard/insights"]
      S_PROFILE["/dashboard/profile"]
    end

    subgraph TPOU["TPO interface — app/(tpo)"]
      direction TB
      T_DASH["/tpo/dashboard"]
      T_DRIVES["/tpo/dashboard/drives<br/>/new · /[id] · /[id]/applicants"]
      T_ANALYTICS["/tpo/dashboard/analytics"]
      T_TRENDING["/tpo/dashboard/analytics/trending"]
      T_GAPS["/tpo/dashboard/analytics/skill-gaps"]
    end

    subgraph ADMU["Admin interface — app/(admin)"]
      direction TB
      A_DASH["/admin/dashboard"]
      A_ANALYTICS["/admin/dashboard/analytics"]
      A_DRIVES["/admin/dashboard/drives"]
      A_QUESTIONS["/admin/dashboard/questions<br/>/new"]
      A_ASSESS["/admin/dashboard/assessments<br/>/new"]
      A_TEMPLATES["/admin/dashboard/templates"]
      A_PLACEMENT["/admin/dashboard/placement"]
    end

    HOOKS["TanStack Query hooks<br/>frontend/hooks/*.ts"]
    APICLIENT["apiClient — axios<br/>baseURL /api/backend<br/>Bearer access token<br/>single-flight 401 refresh"]
    CHARTS["Shared chart + UI layer<br/>Recharts 2.15.4 · chart-theme.ts<br/>MarkdownText · StatusBreakdownChart"]

    STU --> HOOKS
    TPOU --> HOOKS
    ADMU --> HOOKS
    HOOKS --> APICLIENT
    STU --> CHARTS
    TPOU --> CHARTS
    ADMU --> CHARTS
  end

  subgraph EDGE["Edge tier — Next.js server"]
    direction TB
    MW["middleware.ts<br/>reads placer_role cookie<br/>role-based redirect only"]
    REWRITE["next.config.mjs rewrites<br/>/api/backend/:path* →<br/>NEXT_PUBLIC_API_URL/api/v1/:path*"]
  end

  subgraph API["API tier — FastAPI (uvicorn, port 8000)"]
    direction TB
    MWARE["Middleware<br/>RequestIdMiddleware (outermost)<br/>CORSMiddleware · slowapi limiter"]
    DEPS["Dependencies — core/deps.py<br/>get_current_user (DB round-trip)<br/>require_role('student' | 'tpo' | 'admin')"]
    subgraph ROUTERS["Routers — /api/v1"]
      direction TB
      R_AUTH["auth"]
      R_STU["students · resumes"]
      R_DRIVE["drives · applications"]
      R_QUES["questions"]
      R_ASSESS["assessments · gap_analysis"]
      R_ANALYTICS["analytics · market_analytics"]
      R_MATCH["matching · jd_explanation"]
      R_ADMIN["insights · knowledge_admin<br/>observability · health"]
    end
    ERR["Error contract<br/>HTTPException · domain errors<br/>global 500 handler (no stack traces)"]
    MWARE --> DEPS
    DEPS --> ROUTERS
    ROUTERS --> ERR
  end

  subgraph SVC["Domain service layer — backend/app/services"]
    direction TB
    SV_AUTH["auth_service<br/>GoogleAuthService"]
    SV_PROFILE["student_profile_service<br/>profile_autofill_service"]
    SV_RESUME["resume_service<br/>resume_parsing_service"]
    SV_DRIVE["drive_service<br/>screening_service"]
    SV_ASSESS["assessment_service<br/>placement_assessment_service<br/>assessment_selection_service<br/>code_execution_service"]
    SV_KT["knowledge_tracing_service"]
    SV_ANALYTICS["analytics_service"]
    SV_MARKET["market_analytics_service<br/>market_import_service · market_sources"]
    SV_GAP["skill_gap_service<br/>gap_analysis_service<br/>student_insights_service"]
    SV_MATCH["matching_service<br/>application_explanation_service<br/>jd_explanation_service"]
    SV_QUEST["question_service<br/>question_import_service<br/>template_service"]
    SV_STORAGE["storage_service"]
  end

  subgraph REPO["Repository layer — backend/app/repositories"]
    direction TB
    BASE["BaseRepository<br/>create · get_by_id · find_one<br/>find_many · count · update_by_id · delete_by_id"]
    SPECIFIC["User · Student · TPO · Admin · Token<br/>Resume · Company · Drive · Application<br/>Question · Assessment · Attempt · KnowledgeState<br/>Template · ActivityLog · JobMarketPosting<br/>MarketSkillCatalog · MarketImportRun<br/>UnmappedSkill"]
  end

  subgraph ML["AI / ML layer — backend/app/ml"]
    direction TB
    ML_PARSE["Parsing<br/>PyMuPDF text extraction<br/>PaddleOCR fallback<br/>section + contact parser"]
    ML_LLM["LLM client<br/>primary / fallback providers<br/>ollama · nvidia_nim · openrouter<br/>retry + backoff · soft failure"]
    ML_EMBED["Embedding client<br/>ollama or OpenAI-compatible<br/>nomic-embed-text / bge-small / gemini"]
    ML_MATCH["Matching<br/>bi-encoder all-MiniLM-L6-v2<br/>cross-encoder stsb-roberta-base<br/>Platt calibrator"]
    ML_RAG["RAG knowledge store<br/>chunk 1200 / overlap 150<br/>MongoDB cosine, top_k 5"]
  end

  subgraph DATA["Data tier"]
    direction TB
    MONGO[("MongoDB 7 — placer_db<br/>24 collections")]
    FILES[("Resume files<br/>local storage or Cloudinary<br/>local:// or https:// URLs")]
    CACHE[("insights_narrative_cache<br/>knowledge_chunks<br/>trimmed / cosine-scanned")]
  end

  subgraph EXT["External providers"]
    direction TB
    GOOGLE["Google Identity Services<br/>ID-token verification"]
    LLMAPI["LLM + embedding APIs<br/>NVIDIA NIM · OpenRouter<br/>Ollama (local)"]
  end

  APICLIENT -->|"HTTPS / JSON"| MW
  MW --> REWRITE
  REWRITE --> MWARE
  ROUTERS --> SVC
  SVC --> REPO
  REPO --> MONGO
  SVC --> ML
  ML_PARSE --> FILES
  ML_LLM --> LLMAPI
  ML_EMBED --> LLMAPI
  ML_RAG --> MONGO
  SV_GAP --> CACHE
  SV_AUTH --> GOOGLE
  MONGO -.->|"ensure_indexes on startup"| API


