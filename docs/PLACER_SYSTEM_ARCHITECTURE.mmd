    N1["Graded answers only<br/>is_correct is not None"]
    N2["Domain attribution<br/>section metadata first<br/>then keyword table<br/>then question type"]
    N3["Domain score<br/>100 × awarded / max"]
    N4["Radar + trend series"]
    N1 --> N2 --> N3 --> N4
  end

