flowchart TB
  subgraph F1["Resume ingestion and representation"]
    direction TB
    R1["PDF bytes<br/>max 5 MB"]
    R2["PyMuPDF text extraction"]
    R3{"text < 50 chars<br/>or low alphanumeric ratio?"}
    R4["PaddleOCR PP-OCRv4<br/>render 150 DPI"]
    R5["Regex section parser<br/>contact · education · experience<br/>projects · skills"]
    R6["LLM constrained skill extractor<br/>JSON-only, validated against catalogue"]
    R7["skill_set · experience_years"]
    R8["build_resume_text<br/>skills + years"]
    R9["Bi-encoder all-MiniLM-L6-v2<br/>mean pooling + L2 normalisation"]
    R10[("resumes.resume_embedding")]
    R11[("unmapped_skill_suggestions")]
    R1 --> R2 --> R3
    R3 -->|yes| R4 --> R5
    R3 -->|no| R5
    R5 --> R6 --> R7 --> R8 --> R9 --> R10
    R6 -->|rejected phrases| R11
  end

  subgraph F2["Job description representation"]
    direction TB
    J1["placement_drives.jd_text<br/>title · company · description<br/>required skills · years"]
    J2["build_jd_text"]
    J3["Bi-encoder embedding"]
    J4[("placement_drives.jd_embedding")]
    J1 --> J2 --> J3 --> J4
  end

  subgraph F3["Two-stage matching"]
    direction TB
    M1["Stage 1 retrieval<br/>cosine over cached embeddings<br/>top k candidates"]
    M2["Stage 2 rerank<br/>cross-encoder stsb-roberta-base<br/>sigmoid relevance"]
    M3["Platt calibration<br/>calibrated semantic score"]
    M4["Skills score<br/>matched / required"]
    M5["Experience fit<br/>min 1, resume_years / jd_years"]
    M6["Assessment score<br/>assessment_score_pct / 100"]
    M7["Final score<br/>0.40 semantic + 0.30 skills<br/>+ 0.20 experience + 0.10 assessment"]
    M8[("applications.final_score<br/>semantic · skills · experience")]
    M1 --> M2 --> M3 --> M7
    M4 --> M7
    M5 --> M7
    M6 --> M7
    M7 --> M8
  end

  subgraph F4["RAG explanation and narrative"]
    direction TB
    G1["Source text<br/>syllabus · explanations<br/>JD · skill taxonomy"]
    G2["Chunk 1200 chars<br/>overlap 150"]
    G3["Embedding client<br/>nomic-embed-text or equivalent"]
    G4[("knowledge_chunks<br/>vector · embed_model · tags")]
    G5["Retrieve top 5<br/>cosine, same model and dim"]
    G6["Prompt assembly<br/>facts + retrieved context"]
    G7["LLM client<br/>primary → fallback<br/>timeout 30 s · 2 retries"]
    G8[("insights_narrative_cache<br/>keyed by SHA-256 of facts")]
    G9["Markdown narrative<br/>rendered by MarkdownText"]
    G1 --> G2 --> G3 --> G4
    G4 --> G5 --> G6 --> G7 --> G9
    G7 --> G8
  end

  subgraph F5["Knowledge tracing"]
    direction TB
    K1["Graded answer<br/>correct / incorrect"]
    K2["Difficulty weight<br/>easy 0.7 · medium 1.0 · hard 1.3"]
    K3["EMA update<br/>mastery += 0.25 × weight × (target − mastery)"]
    K4["Clamp 0-100<br/>confidence = min 1, attempts / 10"]
    K5[("knowledge_states<br/>history capped at 50")]
    K1 --> K2 --> K3 --> K4 --> K5
  end

  subgraph F6["Analytics inference"]
