# Copy to .env.local — used by next.config.mjs's dev proxy rewrite.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google OAuth client ID (same value as backend's GOOGLE_CLIENT_ID).
# Get one free at https://console.cloud.google.com/apis/credentials
# Must be a "Web application" client with BOTH http://localhost and
# http://localhost:3000 in Authorized JavaScript origins. Missing origins make
# Google return 403 from /gsi/button and the button silently do nothing.
# Open the app at http://localhost:3000 — Google does not accept 127.0.0.1.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
